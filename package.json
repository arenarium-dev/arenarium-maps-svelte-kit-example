		"less": "^4.4.2",
		"svelte": "^5.45.8",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^6.4.1"
	},
	"dependencies": {
		"@arenarium/maps": "latest",
		"@arenarium/maps-integration-maplibre": "^1.0.3",
		"maplibre-gl": "^5.14.0"
	}
}