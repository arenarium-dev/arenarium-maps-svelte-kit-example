{
    "name": "@workspace/test-svelte-kit",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^9.0.0",
        "@sveltejs/kit": "^3.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "less": "^4.9.1",
        "svelte": "^5.59.1",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "vite": "^8.3.8"
    },
    "dependencies": {
        "@arenarium/maps": "^2.0.0",
        "@arenarium/maps-integration-maplibre": "^2.0.0"
    }
}
