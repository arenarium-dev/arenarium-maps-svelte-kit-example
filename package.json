{
	"name": "@workspace/test-svelte-kit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"update": "pnpm update",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
